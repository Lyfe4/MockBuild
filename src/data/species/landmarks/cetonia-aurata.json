  "reference": {
    "title": "Cetonia aurata, from Zhuki Rossii i Zapadnoi Evropy, plate 31, fig. 15",
    "artist": "Georgiy Georgiyevich Jacobson",
    "year": 1913,
    "source": "https://commons.wikimedia.org/wiki/File:Georgiy_Jacobson_-_Beetles_Russia_and_Western_Europe_-_plate_31.jpg",
